# Copy this file to .env and fill it in. NEVER commit .env or share it.

# SQLite database file (created by `npm run setup`)
DATABASE_URL="file:./dev.db"

# REQUIRED in production. 32+ random characters, e.g.:  openssl rand -hex 32
# (a fixed dev-only fallback is used when this is empty during `npm run dev`)
JWT_SECRET=""

# Public address of the app, used in password-reset links
APP_URL="http://localhost:3000"

# Optional: live AI for JD extraction and interview feedback. Without it the built-in engine is used.
# Get a key at https://aistudio.google.com/ and check the current model id in Google's docs.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# Optional: SMTP for password-reset emails. Without it, in development the reset link is shown on screen
# and printed to the server console. In production configure SMTP or users cannot reset passwords.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CareerForge AI <no-reply@yourdomain.com>"
